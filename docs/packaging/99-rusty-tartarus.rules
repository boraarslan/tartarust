# 99-rusty-tartarus.rules
# Non-root access to the Razer Tartarus Pro (USB 1532:0244) and to /dev/uinput,
# so the rusty-tartarus daemon can grab the device's input nodes (evdev) and
# emit remapped events through a virtual uinput device without running as root.
#
# Mechanism:
#   * TAG+="uaccess" lets systemd-logind grant the active seat user access to
#     the device's /dev/input/event* and /dev/hidraw* nodes automatically.
#   * GROUP="plugdev", MODE="0660" is the fallback for non-logind systems and
#     for the static /dev/uinput node (which is NOT seat-tagged, so uaccess
#     does not apply to it — group ownership is the only mechanism there).
#
# The user must be in the "plugdev" group. /dev/uinput is deliberately given to
# "plugdev" (not a separate "uinput" group) so the daemon runs immediately after
# `udevadm trigger` with no extra group / re-login. Trade-off: any plugdev member
# can synthesize input — acceptable on a single-user workstation.
#
# Install: scripts/install-udev.sh   (or copy to /etc/udev/rules.d/ by hand)
# Reload:  sudo udevadm control --reload && sudo udevadm trigger

# --- /dev/input/event* nodes (keyboard + mouse/thumbpad HID interfaces) ---
SUBSYSTEM=="input", ATTRS{idVendor}=="1532", ATTRS{idProduct}=="0244", TAG+="uaccess", GROUP="plugdev", MODE="0660"

# --- /dev/hidraw* node (HID control interface for LED / profile control) ---
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1532", ATTRS{idProduct}=="0244", TAG+="uaccess", GROUP="plugdev", MODE="0660"

# --- /dev/uinput (virtual input device creation; static misc node) ---
KERNEL=="uinput", SUBSYSTEM=="misc", GROUP="plugdev", MODE="0660", OPTIONS+="static_node=uinput"
