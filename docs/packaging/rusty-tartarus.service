# rusty-tartarus daemon — systemd *user* service.
#
# Install:
#   install -Dm644 docs/packaging/rusty-tartarus.service \
#       ~/.config/systemd/user/rusty-tartarus.service
#   # adjust ExecStart to wherever tartarus-daemon is installed, then:
#   systemctl --user daemon-reload
#   systemctl --user enable --now rusty-tartarus.service
#
# Runs as a *user* service inside the graphical session so it inherits
# WAYLAND_DISPLAY / HYPRLAND_INSTANCE_SIGNATURE / DISPLAY — needed for
# per-application auto-switch focus detection. Requires device access via the
# udev rule (docs/packaging/99-rusty-tartarus.rules) or a logind uaccess ACL.

[Unit]
Description=rusty-tartarus — Razer Tartarus Pro driver daemon
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
# Adjust to your install location (e.g. `cargo install --path crates/tartarus-cli`
# puts `tartarus` in ~/.cargo/bin; the daemon binary is `tartarus-daemon`).
ExecStart=%h/.cargo/bin/tartarus-daemon run
Restart=on-failure
RestartSec=2
# The daemon grabs input devices and writes /dev/uinput; no extra privileges are
# needed beyond the udev-granted device access.

[Install]
WantedBy=graphical-session.target
